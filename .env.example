# The web UI sends the selected provider key with each local request.
# Keeping keys out of this file is recommended for personal desktop use.
HOST=127.0.0.1
PORT=8000
RELOAD=false
# Local upload cap in MB; the web UI reads this value from /api/health.
MAX_UPLOAD_MB=2048
# 本地媒体处理固定串行；不同视频的笔记总结最多同时运行三个。
MAX_CONCURRENT_SUMMARIES=3
TASK_HISTORY_LIMIT=100
# VIDEOTONOTES_WORKSPACE=D:\path\to\workspace
# WHISPER_CACHE_DIR=D:\path\to\faster-whisper-cache
# HF_HUB_DISABLE_XET=1
